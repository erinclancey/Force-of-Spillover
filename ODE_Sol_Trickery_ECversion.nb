Cell[CellGroupData[{

Cell["Plot and Simulate Data for a Sample", "Section",
 CellChangeTimes->{{3.9405905499504347`*^9, 3.940590555565954*^9}, {
  3.940613165788364*^9, 
  3.940613179307428*^9}},ExpressionUUID->"39b993ac-38bb-4f34-ac72-\
8c8ffe8f829a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Pars", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Tau]", "->", "70"}], ",", 
     RowBox[{"T", "->", "80"}], ",", 
     RowBox[{"\[Lambda]0", "->", ".01"}], ",", 
     RowBox[{"\[Alpha]", "->", ".005"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.940613317268964*^9, 3.940613348308507*^9}, 
   3.940613803043103*^9, {3.940613921628913*^9, 3.940613928525454*^9}, {
   3.940613976628785*^9, 3.940614005383963*^9}, {3.940614046110787*^9, 
   3.940614049885379*^9}, {3.940614139938107*^9, 3.9406141525512877`*^9}, {
   3.9406143090487413`*^9, 3.9406143648421993`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"517b9a1d-b51c-4a52-a56d-7ae05a109793"],

Cell["Here, i plays the role of current A of individuals", "Text",
 CellChangeTimes->{{3.940613378319379*^9, 
  3.940613386492985*^9}},ExpressionUUID->"b351fc29-398e-4f8e-9787-\
1c5f85c157d6"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"i", ",", "j"}], "}"}], ",", 
   RowBox[{
    RowBox[{"ToPlot", "=", 
     RowBox[{"{", "}"}]}], ";", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "0"}], ",", 
      RowBox[{
       RowBox[{"i", "<=", "T"}], "/.", "Pars"}], ",", 
      RowBox[{"i", "++"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "<=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"T", "-", "\[Tau]"}], ")"}], "/.", "Pars"}], ")"}]}], 
         ",", 
         RowBox[{"PN", "=", 
          RowBox[{"(", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"s", "[", "a", "]"}], "/.", "Youngsters"}], "/.", 
               RowBox[{"a", "->", "i"}]}], "/.", 
              RowBox[{"A", "->", "i"}]}], "/.", "Pars"}], ")"}], ")"}]}]}], 
        "]"}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", ">", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"T", "-", "\[Tau]"}], ")"}], "/.", "Pars"}], ")"}]}], 
         ",", 
         RowBox[{"PN", "=", 
          RowBox[{"(", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"s", "[", "a", "]"}], "/.", "OldstersAC"}], "/.", 
               RowBox[{"a", "->", "i"}]}], "/.", 
              RowBox[{"A", "->", "i"}]}], "/.", "Pars"}], ")"}], ")"}]}]}], 
        "]"}], ";", 
       RowBox[{"ToPlot", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"ToPlot", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"PN", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}]}]}], 
     "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.940613185437696*^9, 3.940613232683799*^9}, {
   3.940613301533908*^9, 3.940613403431284*^9}, {3.9406134592639227`*^9, 
   3.940613481703014*^9}, {3.940613516648355*^9, 3.940613556384437*^9}, {
   3.9406136571702223`*^9, 3.940613670482224*^9}, {3.940613738091126*^9, 
