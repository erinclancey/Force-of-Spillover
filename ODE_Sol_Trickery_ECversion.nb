Cell[CellGroupData[{

Cell["ML Estimation", "Section",
 CellChangeTimes->{{3.9405905583012953`*^9, 
  3.9405905603333483`*^9}},ExpressionUUID->"368ea966-72fd-4657-875d-\
1680a1205645"],

Cell["\<\
Note that here you will set the parameters A and T based on the sample. The \
parameters \[Lambda]0, \[Tau], and \[Alpha] will be estimated. The Likelihood \
function will be piecewise and will need to access one of the three solutions \
above depending on the individuals age and the value of \[Tau]. Its a bit \
clunky but it should be very fast.\
\>", "Text",
 CellChangeTimes->{{3.940590563022046*^9, 
  3.940590684717947*^9}},ExpressionUUID->"ec921692-b8a5-418e-9c1f-\
f88d2e3ad524"]
}, Open  ]]
}, Open  ]]
