Notebook[{

Cell[CellGroupData[{
Cell["PDE  as  ODE?", "Title",
 CellChangeTimes->{{3.940546737196678*^9, 
  3.9405467420780373`*^9}},ExpressionUUID->"c17a45c4-09a7-4dd2-9aca-\
6516be295f99"],

Cell[CellGroupData[{

Cell["Definitions", "Section",
 CellChangeTimes->{{3.9405903303226233`*^9, 
  3.9405903318060503`*^9}},ExpressionUUID->"cf80dca3-4e1a-48d8-bd85-\
39024b74b271"],

Cell["\<\
Our frame of reference is set by the oldest individual in the sample. The \
year that individual was born is time zero. The constants \[Tau], T, and A \
are all measured in the frame of reference. In contrast, the age variable a, \
is an individuals age. \
\>", "Text",
 CellChangeTimes->{{3.940590456462055*^9, 
  3.940590504742988*^9}},ExpressionUUID->"6f58c22f-029c-4325-9596-\
4e83a6d26a68"],

Cell["\<\
\[Tau]\tThe time at which \[Lambda] begins to change
a \tAge (this is the time variable)
T\tThe age of the oldest individual in the sample at the time of sampling
A \tThe age of the focal individual at the time of sampling
\[Lambda]0\tThe ancestral value of \[Lambda]
\[Alpha]\tThe linear rate of change in \[Lambda]\
\>", "Text",
 CellChangeTimes->{{3.940546981594164*^9, 3.940547013221262*^9}, {
  3.940548308816429*^9, 3.940548311141296*^9}, {3.940586466719708*^9, 
  3.940586559501521*^9}, {3.940586766005554*^9, 3.94058677830267*^9}, {
  3.940586941208353*^9, 3.940586943182102*^9}, {3.940587022768941*^9, 
  3.94058707172241*^9}, {3.940587146286564*^9, 3.940587151905937*^9}, {
  3.940587284122684*^9, 3.9405872889050217`*^9}, {3.9405903435224543`*^9, 
  3.940590446514604*^9}, {3.940590520195714*^9, 
  3.940590536268572*^9}},ExpressionUUID->"c4d476db-3b38-4581-b3b3-\
0f853e6d7db7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Before the environment changes", "Section",
 CellChangeTimes->{{3.940586585046631*^9, 3.940586594230864*^9}, {
  3.94058768833358*^9, 
  3.940587689316659*^9}},ExpressionUUID->"5ff4ac89-79fb-4dfb-aeb4-\
92bd5d2c21ab"],

Cell["\<\
Prior to the change in the environment, the probability that an individual is \
seronegative is given by the solution to:\
\>", "Text",
 CellChangeTimes->{{3.940586615907761*^9, 
  3.94058665083928*^9}},ExpressionUUID->"6d7c00d0-4efa-4b49-a3ea-\
593956c49150"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OldstersBC", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"s", "'"}], "[", "a", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", "\[Lambda]0", ")"}]}], 
        RowBox[{"s", "[", "a", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"s", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
    RowBox[{"s", "[", "a", "]"}], ",", "a"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.940546746433441*^9, 3.940546885108129*^9}, {
  3.940547018121972*^9, 3.940547058106635*^9}, {3.940589142526121*^9, 
  3.940589148292*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"1ab4bf6b-2db7-4adb-a5e0-c1aa8b5e18db"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", "a", "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "a"}], " ", "\[Lambda]0"}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.940547051443382*^9, 3.940547059149684*^9}, 
   3.9405889247437973`*^9, 3.94058917320162*^9, 3.940613489322585*^9, 
   3.941124635282027*^9, 3.9544375044506955`*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"8e6bd9b2-b5a4-45df-af70-05f0be5dd2d5"]
}, Open  ]],

Cell["This applies for T-A < \[Tau] and a < \[Tau] - (T-A)", "Text",
 CellChangeTimes->{{3.9405868943211613`*^9, 3.940586932202468*^9}, {
  3.940586963773314*^9, 3.940586979835937*^9}, {3.940587090524955*^9, 
  3.940587124791288*^9}, {3.940588830968748*^9, 
  3.9405888366914673`*^9}},ExpressionUUID->"0f22d2a0-2c4f-4bf2-82e8-\
3ba253a357bd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["After the environment changes", "Section",
 CellChangeTimes->{{3.940586598062278*^9, 
  3.940586603816277*^9}},ExpressionUUID->"c6afb879-c894-4b00-9dff-\
2b424d3387f0"],

Cell[CellGroupData[{

Cell["For individuals born before time \[Tau]", "Subsection",
 CellChangeTimes->{{3.940587840691414*^9, 
  3.940587851967111*^9}},ExpressionUUID->"979e89d2-4b7e-4c6f-ab52-\
414e1616df16"],

Cell["These individuals experience a change in \[Lambda] at a = \[Tau] - \
(T-A)", "Text",
 CellChangeTimes->{{3.940588624398409*^9, 3.940588669232875*^9}, 
   3.9405887080312634`*^9},ExpressionUUID->"5f035b11-2792-40db-b4fb-\
d2f67949adfd"],

Cell["\<\
After world starts to change at time \[Tau], the probability that an \
individual is seronegative is given by the solution to:\
\>", "Text",
 CellChangeTimes->{{3.940547069037525*^9, 3.940547077794594*^9}, {
  3.940586680772381*^9, 3.940586692206647*^9}, {3.940587172036565*^9, 
  3.9405871729003277`*^9}},ExpressionUUID->"a9e199de-337d-487f-b406-\
27a78961e2e2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"OldstersAC", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"s", "'"}], "[", "a", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"\[Lambda]0", "+", 
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"(", 
               RowBox[{"T", "-", "A", "-", "\[Tau]", "+", "a"}], ")"}]}]}], 
            ")"}]}], 
          RowBox[{"s", "[", "a", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"\[Tau]", "-", 
           RowBox[{"(", 
            RowBox[{"T", "-", "A"}], ")"}]}], "]"}], "==", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"\[Tau]", "-", 
              RowBox[{"(", 
               RowBox[{"T", "-", "A"}], ")"}]}], ")"}]}], " ", 
           "\[Lambda]0"}]]}]}], "}"}], ",", 
      RowBox[{"s", "[", "a", "]"}], ",", "a"}], "]"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{"a", ">", "\[Tau]"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9405471161641703`*^9, 3.940547198237774*^9}, {
   3.940547501496563*^9, 3.940547509620821*^9}, {3.940547574751121*^9, 
   3.940547575405483*^9}, {3.94058724682127*^9, 3.940587247977961*^9}, {
   3.940587366806561*^9, 3.940587367043003*^9}, {3.940587898076576*^9, 
   3.940587907631052*^9}, 3.940588070269634*^9, {3.94058873695428*^9, 
   3.940588742797565*^9}, {3.9405887755119753`*^9, 3.940588785150833*^9}, {
   3.940589155653816*^9, 3.940589158016526*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"99b9ec4b-3556-4e4b-83c0-b204161b1563"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", "a", "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["a", "2"], " ", "\[Alpha]"}], "2"]}], "-", 
      RowBox[{"a", " ", "\[Lambda]0"}], "+", 
      RowBox[{"a", " ", "\[Alpha]", " ", 
       RowBox[{"(", 
        RowBox[{"A", "-", "T", "+", "\[Tau]"}], ")"}]}], "-", 
      RowBox[{
       FractionBox["1", "2"], " ", "\[Alpha]", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"A", "-", "T", "+", "\[Tau]"}], ")"}], "2"]}]}]]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.940588927573032*^9, 3.940589175801411*^9, 
  3.9406134920833807`*^9, 3.941124636369819*^9, 3.954437505700286*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"68291b30-fb4d-4067-ba60-34821dc7af19"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"OldstersAC", "/.", 
   RowBox[{"a", "->", "A"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.940614221864201*^9, 3.9406142310875463`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"d207385e-8220-4955-a807-70957931263d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", "A", "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "A"}], " ", "\[Lambda]0"}], "-", 
      RowBox[{
       FractionBox["1", "2"], " ", "\[Alpha]", " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"T", "-", "\[Tau]"}], ")"}], "2"]}]}]]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.940614232802347*^9, 3.9411246364322224`*^9, 
  3.9544375057797484`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"c2c82883-2c85-4d21-bd0c-80dbb6859d4c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["For individuals born after time \[Tau]", "Subsection",
 CellChangeTimes->{{3.940587866912757*^9, 
  3.940587872219705*^9}},ExpressionUUID->"0d6f1f7f-1617-45d0-a13f-\
087c9d91edfd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Youngsters", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"s", "'"}], "[", "a", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"\[Lambda]0", "+", 
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"(", 
               RowBox[{"T", "-", "A", "-", "\[Tau]", "+", "a"}], ")"}]}]}], 
            ")"}]}], 
          RowBox[{"s", "[", "a", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"s", "[", "0", "]"}], "==", "1"}]}], "}"}], ",", 
      RowBox[{"s", "[", "a", "]"}], ",", "a"}], "]"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{"a", ">", "\[Tau]"}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9405471161641703`*^9, 3.940547198237774*^9}, {
  3.940547501496563*^9, 3.940547509620821*^9}, {3.940547574751121*^9, 
  3.940547575405483*^9}, {3.94058724682127*^9, 3.940587247977961*^9}, {
  3.940587366806561*^9, 3.940587367043003*^9}, {3.9405879101639853`*^9, 
  3.9405879107742653`*^9}, {3.9405889051649637`*^9, 3.940588908245372*^9}, {
  3.940589165813696*^9, 3.940589168090478*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"392e1d8a-fdca-49e0-9f00-4c954494c28b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", "a", "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", "a", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "\[Alpha]"}], "+", 
        RowBox[{"2", " ", "\[Lambda]0"}], "-", 
        RowBox[{"2", " ", "\[Alpha]", " ", 
         RowBox[{"(", 
          RowBox[{"A", "-", "T", "+", "\[Tau]"}], ")"}]}]}], ")"}]}]]}], 
   "}"}], "}"}]], "Output",
 CellChangeTimes->{3.940588930363256*^9, 3.940589178326558*^9, 
  3.940613492247889*^9, 3.941124636495254*^9, 3.9544375058558097`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"0c794a4f-9ad9-49c2-8566-a445b51fd053"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Youngsters", "/.", 
   RowBox[{"a", "->", "A"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.940614221864201*^9, 3.9406142310875463`*^9}, {
  3.940614269193247*^9, 3.94061427066356*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"656c36c1-1785-40f6-bfea-7537ec13db67"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", "A", "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "2"], " ", "A", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[Lambda]0"}], "+", 
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"(", 
          RowBox[{"A", "-", 
           RowBox[{"2", " ", "T"}], "+", 
           RowBox[{"2", " ", "\[Tau]"}]}], ")"}]}]}], ")"}]}]]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.9406142714500027`*^9, 3.9411246365265064`*^9, 
  3.9544375058915205`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"08486831-e65b-4bcc-b3eb-e6b17b644f8f"]
}, Open  ]]
}, Open  ]]
