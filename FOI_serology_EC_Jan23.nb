}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mysol", "=", 
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"PDEnew", ",", " ", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"0", ",", "t"}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"a", ",", "0"}], "]"}], "==", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Lambda]"}], " ", "a"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "t"}], "}"}]}], "]"}], "//", 
   "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{3.9405137802299814`*^9, 3.940513825547823*^9}, {
  3.940513870987075*^9, 3.940513887264699*^9}, {3.941296337868703*^9, 
  3.9412963381043468`*^9}, {3.9412963773396964`*^9, 3.9412963942498207`*^9}, {
  3.9466754396091113`*^9, 3.9466754441230993`*^9}},
 CellLabel->
  "In[211]:=",ExpressionUUID->"91a24f16-80b0-4428-a897-b0f1b4b1e811"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "a"}], " ", "\[Lambda]", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Rho]"}], ")"}]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[Lambda]", " ", 
           RowBox[{"(", 
            RowBox[{"t", "+", 
             RowBox[{"a", " ", "\[Rho]"}], "-", 
             RowBox[{"t", " ", "\[Rho]"}]}], ")"}]}]]}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{
            RowBox[{"-", "a"}], "+", "t"}], "]"}]}], ")"}]}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"a", " ", "\[Lambda]"}]], " ", 
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{
          RowBox[{"-", "a"}], "+", "t"}], "]"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
