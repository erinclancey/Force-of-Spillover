Cell[CellGroupData[{

Cell["Changing FOI from constant FOI at t=0", "Chapter",
 CellChangeTimes->{{3.940512458529548*^9, 3.9405124605913963`*^9}, {
  3.9405133791641493`*^9, 
  3.940513386838024*^9}},ExpressionUUID->"2c79ac71-2fac-4905-836f-\
2e777dc26f74"],

Cell[CellGroupData[{

Cell["\<\
FOI has a starting value for \[Lambda]0 and changes to a new constant value \
\[Lambda]\
\>", "Section",
 CellChangeTimes->{{3.9405140056656494`*^9, 
  3.9405140580273933`*^9}},ExpressionUUID->"d8848887-634e-4bad-9582-\
2c09c735ee5c"],

Cell["When t=0 the FOI is equal to \[Lambda]0:", "Text",
 CellChangeTimes->{{3.9405134323186445`*^9, 
  3.9405134730064588`*^9}},ExpressionUUID->"e0b06cce-5b8f-4753-8694-\
64c50a799c8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PDEnew", " ", "=", " ", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Lambda]"}], "*", "\[Rho]", "*", 
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}]}], " ", "-", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"a", ",", "t"}], "]"}], ",", "a"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9466753960068426`*^9, 3.9466754060997343`*^9}},
 CellLabel->
  "In[210]:=",ExpressionUUID->"9fcaf1c2-5647-469d-bea9-3806e3b33149"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["s", 
    TagBox[
     RowBox[{"(", 
      RowBox[{"0", ",", "1"}], ")"}],
     Derivative],
    MultilineFunction->None], "[", 
   RowBox[{"a", ",", "t"}], "]"}], "\[Equal]", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "\[Lambda]"}], " ", "\[Rho]", " ", 
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}]}], "-", 
   RowBox[{
    SuperscriptBox["s", 
     TagBox[
      RowBox[{"(", 
       RowBox[{"1", ",", "0"}], ")"}],
      Derivative],
     MultilineFunction->None], "[", 
    RowBox[{"a", ",", "t"}], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.9466754112712927`*^9, 3.946675434297241*^9}, {
   3.946675594799788*^9, 3.94667560772843*^9}, 3.946678319598491*^9, 
   3.946678350127631*^9, {3.9467294394796653`*^9, 3.9467294581164036`*^9}, {
