  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "2"], " ", "a", " ", 
      RowBox[{"(", 
       RowBox[{
