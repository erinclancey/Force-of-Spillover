Cell["\<\
Solve the PDE assuming all individuals are born (a=0) with the probability of \
being susceptible =1 (i.e. s[0,t]==1).\
\>", "Text",
 CellChangeTimes->{{3.9405131434894276`*^9, 
  3.9405131973018694`*^9}},ExpressionUUID->"5fdde280-92a5-4a8f-a701-\
003ac2106a4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PDE", ",", 
      RowBox[{
       RowBox[{"s", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "==", "1"}]}], "}"}], ",", 
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "t"}], "}"}]}], "]"}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9405130892015305`*^9, 3.9405130895623283`*^9}, {
  3.9464084263486333`*^9, 3.94640844093181*^9}, {3.9464089346348248`*^9, 
  3.9464089376690288`*^9}},
 CellLabel->
  "In[205]:=",ExpressionUUID->"52bef2bc-6ab5-413d-9fbd-0c5b2756b53e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       TemplateBox[{
         RowBox[{"-", 
           RowBox[{"\[Lambda]", "[", 
             RowBox[{
               RowBox[{"-", "a"}], "+", "t", "+", 
               RowBox[{"K", "[", "1", "]"}]}], "]"}]}], 
         RowBox[{"K", "[", "1", "]"}], "1", "0"},
        "InactiveIntegrate",
        DisplayFunction->(RowBox[{
           SubsuperscriptBox[
            StyleBox["\[Integral]", "Inactive"], #3, #4], 
           RowBox[{#, 
             RowBox[{
               StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]& ),
        InterpretationFunction->(RowBox[{
           RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
           RowBox[{#, ",", 
             RowBox[{"{", 
               RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]}], "+", 
      TemplateBox[{
        RowBox[{"-", 
          RowBox[{"\[Lambda]", "[", 
            RowBox[{
              RowBox[{"-", "a"}], "+", "t", "+", 
              RowBox[{"K", "[", "1", "]"}]}], "]"}]}], 
        RowBox[{"K", "[", "1", "]"}], "1", "a"},
       "InactiveIntegrate",
       DisplayFunction->(RowBox[{
          SubsuperscriptBox[
           StyleBox["\[Integral]", "Inactive"], #3, #4], 
          RowBox[{#, 
            RowBox[{
              StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]& ),
       InterpretationFunction->(RowBox[{
          RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
          RowBox[{#, ",", 
            RowBox[{"{", 
              RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]}]]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.9405130649728107`*^9, 3.940513107720359*^9}, {
