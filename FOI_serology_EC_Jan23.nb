Cell["\<\
This solution is the starting condition (i.e. S[a,0]==Exp[-\[Lambda]0 a]) for \
t=0 for all future models. This is because we assume that FOI in the past was \
constant and the current conditions are now changing the FOI. For all models \
below t>0. \
\>", "Text",
 CellChangeTimes->{{3.9405120186166873`*^9, 3.9405120883809676`*^9}, {
  3.9405121330552087`*^9, 3.9405121745371914`*^9}, {3.940512404929747*^9, 
  3.9405124139905005`*^9}},ExpressionUUID->"6f10e3e0-fc05-41f7-b6c1-\
06e6a460d932"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Define a partial differential equation for the when FOI is linear\
\>", "Section",
 CellChangeTimes->{{3.9405122992081113`*^9, 3.9405123262810774`*^9}, {
  3.9405145717275467`*^9, 
  3.9405145745764728`*^9}},ExpressionUUID->"36b33258-323f-4629-abfb-\
794cadb329b8"],

Cell["Constant force of infection:", "Text",
 CellChangeTimes->{{3.940433762003395*^9, 3.9404337791597633`*^9}, {
  3.9405117776443357`*^9, 
  3.940511778494028*^9}},ExpressionUUID->"5ca0929a-630b-4274-857e-\
4795ab1f0e13"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PDE3", " ", "=", " ", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"\[Lambda]0", " ", "+", " ", 
        RowBox[{"\[Lambda]", "*", "t"}]}], ")"}]}], "*", 
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}]}], " ", "-", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"a", ",", "t"}], "]"}], ",", "a"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.940513217026409*^9, 3.9405132230360236`*^9}, {
  3.9405145972959175`*^9, 3.9405146050583143`*^9}, {3.940516336019588*^9, 
  3.940516340916663*^9}, {3.940516391667658*^9, 3.9405163950609937`*^9}, {
  3.9405237369052563`*^9, 3.9405237397382803`*^9}},
 CellLabel->
  "In[208]:=",ExpressionUUID->"74ce840e-37cd-4f14-b7ad-86407c84e2c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["s", 
    TagBox[
     RowBox[{"(", 
      RowBox[{"0", ",", "1"}], ")"}],
     Derivative],
    MultilineFunction->None], "[", 
   RowBox[{"a", ",", "t"}], "]"}], "\[Equal]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "t"}], " ", "\[Lambda]"}], "-", "\[Lambda]0"}], ")"}], 
    " ", 
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}]}], "-", 
   RowBox[{
    SuperscriptBox["s", 
     TagBox[
      RowBox[{"(", 
