Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sdot", "=", " ", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"s", "[", "a", "]"}], ",", "a"}], "]"}], "==", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Lambda]"}], "*", 
     RowBox[{"s", "[", "a", "]"}]}], "+", 
