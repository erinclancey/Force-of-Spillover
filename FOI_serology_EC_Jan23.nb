Cell[CellGroupData[{

Cell["Define a partial differential equation for the general case", "Section",
 CellChangeTimes->{{3.94051132710207*^9, 
  3.940511342772418*^9}},ExpressionUUID->"a0d10a80-c999-4474-980f-\
df35cc5b6460"],

Cell["\<\
s[a,t] gives the probability an individual of age a has negative serology at \
time t and \[Lambda] is the force of infection (FOI).\
\>", "Text",
 CellChangeTimes->{{3.940433725160301*^9, 3.9404337556365347`*^9}, {
  3.9405124739668627`*^9, 
  3.940512486661576*^9}},ExpressionUUID->"69b0eab3-7a84-4363-a317-\
962afccf1ad3"],

Cell["Arbitrary force of infection:", "Text",
 CellChangeTimes->{{3.940433762003395*^9, 
  3.9404337791597633`*^9}},ExpressionUUID->"58e8a16b-b664-477c-a32c-\
7a392aeae86b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PDE", " ", "=", " ", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Lambda]", "[", "t", "]"}]}], "*", 
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}]}], " ", "-", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"a", ",", "t"}], "]"}], ",", "a"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.940433791413168*^9, 3.940433816049383*^9}, {
  3.940434041993202*^9, 3.940434044027499*^9}, {3.9405114813289185`*^9, 
  3.940511481660508*^9}, {3.9405115379033327`*^9, 3.940511557488922*^9}, {
  3.9405129378333855`*^9, 3.9405129435182705`*^9}},
 CellLabel->
  "In[204]:=",ExpressionUUID->"edaf245a-b6be-429d-83db-bea6baee5693"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["s", 
    TagBox[
     RowBox[{"(", 
      RowBox[{"0", ",", "1"}], ")"}],
     Derivative],
    MultilineFunction->None], "[", 
   RowBox[{"a", ",", "t"}], "]"}], "\[Equal]", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}]}], " ", 
    RowBox[{"\[Lambda]", "[", "t", "]"}]}], "-", 
   RowBox[{
