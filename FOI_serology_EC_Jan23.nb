Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Rdot", "=", " ", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"R", "[", 
      RowBox[{"a", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
   RowBox[{
    RowBox[{"\[Lambda]", "*", 
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}]}], "-", "\[Omega]R", " ", "+", " ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"a", ",", "t"}], "]"}], ",", "a"}], "]"}], "-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"R", "[", 
       RowBox[{"a", ",", "t"}], "]"}], ",", "a"}], "]"}]}]}]}]], "Input",
