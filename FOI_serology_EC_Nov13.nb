 CellLabel->
  "In[685]:=",ExpressionUUID->"db42b18f-13ec-4ccf-9c7e-b1376a748e3a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "2"], " ", "a", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a", " ", "\[Lambda]"}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"t", " ", "\[Lambda]"}], "+", "\[Lambda]0"}], ")"}]}]}], 
       ")"}]}]]}], "}"}], "}"}]], "Output",
