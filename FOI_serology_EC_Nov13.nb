Cell["\<\
Solve the PDE assuming all individuals are born (a=0) with the probability of \
being susceptible =1 (i.e. s[0,t]==1).\
\>", "Text",
 CellChangeTimes->{{3.9405131434894276`*^9, 
  3.9405131973018694`*^9}},ExpressionUUID->"12be04f0-4ce6-462f-a5e4-\
2b3f8cfaf305"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"PDE3", ",", " ", 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"0", ",", "t"}], "]"}], "==", "1"}]}], "}"}], ",", 
   RowBox[{"s", "[", 
    RowBox[{"a", ",", "t"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "t"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9405116919254074`*^9, 3.9405116933722477`*^9}, {
  3.9405117334320602`*^9, 3.9405117340638*^9}, {3.9405132495158367`*^9, 
  3.9405132898437166`*^9}, {3.940514609987315*^9, 3.9405146103499513`*^9}, {
  3.940514671667549*^9, 3.9405146721157007`*^9}, {3.9405148576099806`*^9, 
