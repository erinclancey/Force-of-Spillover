Cell["\<\
Solve the PDE assuming all individuals are born (a=0) with the probability of \
being susceptible =1 (i.e. s[0,t]==1).\
\>", "Text",
 CellChangeTimes->{{3.9405131434894276`*^9, 
  3.9405131973018694`*^9}},ExpressionUUID->"5fdde280-92a5-4a8f-a701-\
003ac2106a4e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"PDE", ",", 
      RowBox[{
       RowBox[{"s", "[", 
        RowBox[{"0", ",", "t"}], "]"}], "==", "1"}]}], "}"}], ",", 
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "t"}], "}"}]}], "]"}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9405130892015305`*^9, 3.9405130895623283`*^9}},
 CellLabel->
  "In[681]:=",ExpressionUUID->"52bef2bc-6ab5-413d-9fbd-0c5b2756b53e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}], "\[Rule]", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       TemplateBox[{
         RowBox[{"-", 
           RowBox[{"\[Lambda]", "[", 
             RowBox[{
               RowBox[{"-", "a"}], "+", "t", "+", 
               RowBox[{"K", "[", "1", "]"}]}], "]"}]}], 
         RowBox[{"K", "[", "1", "]"}], "1", "0"},
        "InactiveIntegrate",
        DisplayFunction->(RowBox[{
           SubsuperscriptBox[
            StyleBox["\[Integral]", "Inactive"], #3, #4], 
           RowBox[{#, 
             RowBox[{
               StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]& ),
        InterpretationFunction->(RowBox[{
           RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
           RowBox[{#, ",", 
             RowBox[{"{", 
               RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]}], "+", 
      TemplateBox[{
        RowBox[{"-", 
          RowBox[{"\[Lambda]", "[", 
            RowBox[{
              RowBox[{"-", "a"}], "+", "t", "+", 
              RowBox[{"K", "[", "1", "]"}]}], "]"}]}], 
        RowBox[{"K", "[", "1", "]"}], "1", "a"},
       "InactiveIntegrate",
       DisplayFunction->(RowBox[{
          SubsuperscriptBox[
           StyleBox["\[Integral]", "Inactive"], #3, #4], 
          RowBox[{#, 
            RowBox[{
              StyleBox["\[DifferentialD]", "Inactive"], #2}]}]}]& ),
       InterpretationFunction->(RowBox[{
          RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
          RowBox[{#, ",", 
            RowBox[{"{", 
              RowBox[{#2, ",", #3, ",", #4}], "}"}]}], "]"}]& )]}]]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.9405130649728107`*^9, 3.940513107720359*^9}, {
   3.9405136826349387`*^9, 3.94051369675399*^9}, 3.940515027850849*^9, 
   3.9405169576712418`*^9, 3.9405237814085894`*^9, 3.9405240871006947`*^9, 
   3.940524990269354*^9, 3.9405250316032944`*^9, 3.94052563856698*^9, 
   3.9405260109366655`*^9, 3.9405261229645796`*^9, 3.9405261796249332`*^9, 
