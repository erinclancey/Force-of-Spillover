Cell["\<\
FOI has a starting value for \[Lambda]0 and changes to a new constant value \
\[Lambda]\
\>", "Section",
 CellChangeTimes->{{3.9405140056656494`*^9, 
  3.9405140580273933`*^9}},ExpressionUUID->"d8848887-634e-4bad-9582-\
2c09c735ee5c"],

Cell["When t=0 the FOI is equal to \[Lambda]0:", "Text",
 CellChangeTimes->{{3.9405134323186445`*^9, 
  3.9405134730064588`*^9}},ExpressionUUID->"e0b06cce-5b8f-4753-8694-\
64c50a799c8b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mysol", "=", 
  RowBox[{
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"PDE2", ",", " ", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"0", ",", "t"}], "]"}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"a", ",", "0"}], "]"}], "==", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[Lambda]0"}], " ", "a"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"s", "[", 
      RowBox[{"a", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "t"}], "}"}]}], "]"}], "//", 
   "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{3.9405137802299814`*^9, 3.940513825547823*^9}, {
  3.940513870987075*^9, 3.940513887264699*^9}, {3.941296337868703*^9, 
  3.9412963381043468`*^9}, {3.9412963773396964`*^9, 3.9412963942498207`*^9}},
 CellLabel->
  "In[686]:=",ExpressionUUID->"91a24f16-80b0-4428-a897-b0f1b4b1e811"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"s", "[", 
     RowBox[{"a", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "a"}], " ", 
       RowBox[{"(", 
        RowBox[{"\[Lambda]", "+", "\[Lambda]0"}], ")"}]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"a", " ", "\[Lambda]"}], "+", 
           RowBox[{"t", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "\[Lambda]"}], "+", "\[Lambda]0"}], ")"}]}]}]]}], 
        " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"HeavisideTheta", "[", 
           RowBox[{
            RowBox[{"-", "a"}], "+", "t"}], "]"}]}], ")"}]}], "+", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"a", " ", "\[Lambda]0"}]], " ", 
        RowBox[{"HeavisideTheta", "[", 
         RowBox[{
          RowBox[{"-", "a"}], "+", "t"}], "]"}]}]}], ")"}]}]}], "}"}], 
  "}"}]], "Output",
